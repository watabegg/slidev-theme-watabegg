{
  "name": "slidev-theme-watabegg",
  "version": "1.2.1",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "author": "watabegg",
  "description": "A personal Slidev theme for watabegg.",
  "license": "MIT",
  "homepage": "https://github.com/watabegg/slidev-theme-watabegg#readme",
  "bugs": {
    "url": "https://github.com/watabegg/slidev-theme-watabegg/issues"
  },
  "keywords": [
    "slidev-theme",
    "slidev",
    "watabegg",
    "personal-theme"
  ],
  "engines": {
    "node": ">=22.12.0",
    "slidev": ">=53.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/watabegg/slidev-theme-watabegg"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "components",
    "layouts",
    "setup",
    "styles",
    "utils",
    "custom-nav-controls.vue",
    "slide-bottom.vue",
    "global-bottom.vue"
  ],
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md",
    "dev:polling": "CHOKIDAR_USEPOLLING=1 slidev example.md",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm run test && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run build && pnpm pack --dry-run",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@slidev/cli": "^53.0.0",
    "@slidev/client": "^53.0.0",
    "@slidev/types": "^53.0.0",
    "bumpp": "^12.3.0",
    "markdown-it": "^14.3.2",
    "playwright-chromium": "^1.63.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "background": "#FFFFFF",
      "fonts": {
        "sans": "M PLUS 2",
        "mono": "Fira Code"
      },
      "lineNumbers": false
    }
  }
}
