{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "paths": {
      "@slidev/client": ["./types/slidev-client.d.ts"]
    }
  },
  "include": [
    "components/**/*.vue",
    "layouts/**/*.vue",
    "setup/**/*.ts",
    "styles/**/*.ts",
    "utils/**/*.ts",
    "env.d.ts",
    "types/**/*.d.ts",
    "slide-bottom.vue",
    "custom-nav-controls.vue",
    "global-bottom.vue"
  ]
}
